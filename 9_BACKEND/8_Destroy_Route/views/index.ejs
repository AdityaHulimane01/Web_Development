<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Posts</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <h1>Quora Posts</h1>
   <div class="posts">
    <% for(let post of posts) { %>
        <div class="post">
            <h3 class="user">@<%= post.username %></h3>
            <h4 class="content"><%= post.content %></h4>
            <a href="http://localhost:8080/posts/<%= post.id %>"><button>Show</button></a> <nbsp></nbsp><nbsp></nbsp>
            <a href="http://localhost:8080/posts/<%= post.id %>/edit"><button>Edit</button></a> <nbsp></nbsp><nbsp></nbsp>
            <form action="/posts/<%= post.id %>?_method=DELETE" method="post">
                <button>Delete</button>
            </form>
        </div>
    <% } %>
    <br>
    <br>
    <a href="http://localhost:8080/posts/new"><button>Add Post</button></a>    <!--//adding this anchore tag for button with the path to the new post page.-->
</div>
</body>

</html>