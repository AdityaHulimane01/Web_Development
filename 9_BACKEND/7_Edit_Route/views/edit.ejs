<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>
</head>

<body>
    <h1>Edit Post</h1>
    <h3>User ID : <%= post.id %>
    </h3>
    <h3>User Name : <%= post.username %>
    </h3>
    <form action="/posts/<%= post.id %>?_method=PATCH" method="post">
       <textarea name="content" rows="10" cols="35"><%= post.content %></textarea>
       <br>
       <br>
       <button>Edit</button>
    </form>
</body>

</html>