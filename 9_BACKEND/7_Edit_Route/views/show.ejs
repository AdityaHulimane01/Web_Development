<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Post in detail</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>Here is your post in detailed</h1>
    <div class="post">
        <h2>Post ID : <%= post.id %></h2>
        <h2 class="user">@<%= post.username %></h2>
        <h3 class="content"><%= post.content %></h2>
        <a href="http://localhost:8080/posts"><button>Back</button></a>
    </div>
</body>
</html>