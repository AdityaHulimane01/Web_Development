<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All User Details</title>
    <style>
        table , tr , th {
            border: 2px solid black;
        }
    </style>
</head>
<body>
    <div>
        <table>
            <tr> 
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
        </tr>
        <tr>
            <% for(user of users){ %>
               <tr>
                <th><%= user.id %></th>
                <th><%= user.username %></th>
                <th><%= user.email %></th>
               </tr>   
             <% } %>
        </tr>
        </table>
    </div>
</body>
</html>